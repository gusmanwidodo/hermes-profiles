# ── OS / Python ───────────────────────────────────────────────
.DS_Store
*.pyc
__pycache__/

# ── Secrets & credentials (NEVER commit) ──────────────────────
# Per-profile runtime secrets: bot tokens, auth, dashboard hashes
**/.env
**/.env.*
!**/.env.example
**/auth.json
**/auth.lock
**/config.yaml
**/config.yaml.bak*
**/*.key
**/*.pem
**/secrets.*

# ── Per-profile runtime state (regenerated by Hermes) ─────────
# These live inside profiles/<name>/ and must never be committed.
# NOTE: profile.yaml, SOUL.md, README.md, AGENTS.md, and skill
# symlinks are NOT ignored — they are the tracked profile source.
profiles/*/state/
profiles/*/state.db*
profiles/*/sessions/
profiles/*/memories/
profiles/*/logs/
profiles/*/cache/
profiles/*/cron/
profiles/*/lsp/
profiles/*/bin/
profiles/*/gateway/
profiles/*/gateway*.log
profiles/*/gateway.lock
profiles/*/gateway.pid
profiles/*/gateway_state.json
profiles/*/channel_directory.json
profiles/*/processes.json
profiles/*/projects.db
profiles/*/verification_evidence.db
profiles/*/terminal-sessions/
profiles/*/audio_cache/
profiles/*/image_cache/
profiles/*/images/
profiles/*/attachments/
profiles/*/pairing/
profiles/*/pending_messages/
profiles/*/sandboxes/
profiles/*/hooks/
profiles/*/desktop/
profiles/*/platforms/
profiles/*/.curator_backups/
profiles/*/.skills_prompt_snapshot.json
profiles/*/.hermes_history
profiles/*/.update_check
profiles/*/*.etag
profiles/*/models_dev_cache.json
profiles/*/ollama_cloud_models_cache.json
profiles/*/provider_models_cache.json
profiles/*/tui-theme-boot.json

# Per-profile skill runtime metadata (keep SKILL.md + symlinks tracked)
profiles/*/skills/.bundled_manifest
profiles/*/skills/.curator_ledger.jsonl
profiles/*/skills/.curator_state
profiles/*/skills/.usage.json
profiles/*/skills/.usage.json.lock

# Hermes-bundled skill categories auto-synced into each active profile.
# They ship with Hermes itself, not with this repo — tracking them would
# bloat the repo and collide on every upstream pull. Skills that belong to
# this repo live in /skills and are referenced by relative symlink.
profiles/*/skills/apple/
profiles/*/skills/autonomous-ai-agents/
profiles/*/skills/creative/
profiles/*/skills/devops/
profiles/*/skills/email/
profiles/*/skills/github/
profiles/*/skills/media/
profiles/*/skills/micro-saas/
profiles/*/skills/mlops/
profiles/*/skills/note-taking/
profiles/*/skills/productivity/
profiles/*/skills/research/
profiles/*/skills/smart-home/
profiles/*/skills/social-media/
profiles/*/skills/software-development/
profiles/*/skills/strategy/
profiles/*/skills/mermaid-diagrams/

# Per-profile runtime locks and state flags
profiles/*/.backup.lock
profiles/*/.clean_shutdown
profiles/*/.hermes-update-in-progress
profiles/*/.restart_failure_counts
profiles/*/state-snapshots/
profiles/*/web-ui-build-stamp.json

# ── Top-level runtime (kanban, dbs) ───────────────────────────
kanban/
kanban.db*
*.db-shm
*.db-wal
